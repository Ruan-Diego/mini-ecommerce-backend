      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer token-pact"
        },
        "matchingRules": {
          "header": {
            "Authorization": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "Bearer .+"
                }
              ]
            }
          }
        },
        "method": "GET",
        "path": "/pedidos/fretes/cotacao",
        "query": {
          "cep": [
            "01310100"
          ],
          "subtotal": [
            "200.00"
          ]
        }
      },
      "response": {
        "body": [
          {
            "codigo": "padrao",
            "nome": "Padrão",
            "prazoDias": 7,
            "valor": 19.9
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].codigo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
