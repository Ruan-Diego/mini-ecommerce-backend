{
  "consumer": {
    "name": "mfe-admin"
  },
  "interactions": [
    {
      "description": "a atualização de um produto",
      "providerStates": [
        {
          "name": "existe o produto ativo esfera-chrome com o id 11111111-1111-4111-8111-111111111111"
        }
      ],
      "request": {
        "body": {
          "categoriaId": "33333333-3333-4333-8333-333333333333",
          "descricao": "Esfera de vidro azul.",
          "imagens": [
            {
              "textoAlternativo": "Esfera azul",
              "url": "https://cdn.mini.dev/azul.webp"
            }
          ],
          "nome": "Esfera Chrome",
          "preco": 259
        },
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer token-pact-admin",
          "Content-Type": "application/json"
        },
        "method": "PUT",
        "path": "/catalogo/admin/produtos/11111111-1111-4111-8111-111111111111"
      },
      "response": {
        "status": 204
      }
    },
    {
      "description": "a busca de produtos pelo texto esfera",
      "providerStates": [
        {
          "name": "existe o produto ativo esfera-chrome com o id 11111111-1111-4111-8111-111111111111"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json",
          "Authorization": "Bearer token-pact-admin"
        },
        "method": "GET",
        "path": "/catalogo/produtos",
        "query": {
          "busca": [
            "esfera"
          ],
          "pagina": [
            "0"
          ],
          "tamanho": [
            "20"
          ]
        }
      },
      "response": {
        "body": {
          "itens": [
            {
              "ativo": true,
              "categoriaId": "33333333-3333-4333-8333-333333333333",
              "descricao": "Esfera de aço polido.",
              "id": "11111111-1111-4111-8111-111111111111",
              "imagens": [
                {
                  "textoAlternativo": "Esfera cromada",
                  "url": "https://cdn.mini.dev/esfera.webp"
                }
              ],
              "nome": "Esfera Chrome",
              "preco": 289,
              "sku": "ESF-CHROME-01",
              "slug": "esfera-chrome"
            }
          ],
          "pagina": 0,
          "tamanho": 20,
          "total": 1,
          "totalPaginas": 1
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.itens": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.itens[*].ativo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].categoriaId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.itens[*].descricao": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.itens[*].imagens": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$.itens[*].imagens[*].textoAlternativo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].imagens[*].url": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].preco": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "number"
                }
              ]
            },
            "$.itens[*].sku": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.itens[*].slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.pagina": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.tamanho": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.total": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.totalPaginas": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a desativação de um produto",
