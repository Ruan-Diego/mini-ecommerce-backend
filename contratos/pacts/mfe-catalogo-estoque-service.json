{
  "consumer": {
    "name": "mfe-catalogo"
  },
  "interactions": [
    {
      "description": "a disponibilidade de um produto com saldo",
      "providerStates": [
        {
          "name": "o produto 11111111-1111-4111-8111-111111111111 tem 3 unidades disponíveis no estoque"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/estoque/11111111-1111-4111-8111-111111111111"
      },
      "response": {
        "body": {
          "disponivel": 3,
          "emEstoque": true,
          "estoqueBaixo": true,
          "produtoId": "11111111-1111-4111-8111-111111111111",
          "reservado": 0
        },
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$.disponivel": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            },
            "$.emEstoque": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.estoqueBaixo": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.produtoId": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$.reservado": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "integer"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "a disponibilidade de um produto sem estoque cadastrado",
      "providerStates": [
        {
          "name": "o produto 55555555-5555-4555-8555-555555555555 não tem estoque cadastrado"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/estoque/55555555-5555-4555-8555-555555555555"
      },
      "response": {
        "status": 404
      }
    }
  ],
  "metadata": {
    "pact-js": {
      "version": "17.1.4"
    },
    "pactRust": {
      "ffi": "0.5.8",
      "models": "1.3.16"
    },
    "pactSpecification": {
      "version": "3.0.0"
    }
  },
  "provider": {
    "name": "estoque-service"
  }
}