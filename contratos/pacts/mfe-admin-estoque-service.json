                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/(problem\\+)?json.*"
                }
              ]
            }
          }
        },
        "status": 422
      }
    },
