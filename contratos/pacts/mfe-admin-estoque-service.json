        "method": "POST",
        "path": "/estoque/admin/estoque/11111111-1111-4111-8111-111111111111/ajustes"
      },
      "response": {
        "body": {
          "detail": "a perda de 10 é maior que o disponível (3)"
        },
        "headers": {
          "Content-Type": "application/problem+json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$.detail": {
              "combine": "AND",
              "matchers": [
