{
  "consumer": {
    "name": "mfe-catalogo"
  },
  "interactions": [
    {
      "description": "a lista de categorias",
      "providerStates": [
        {
          "name": "existe a categoria esferas"
        }
      ],
      "request": {
        "headers": {
          "Accept": "application/json"
        },
        "method": "GET",
        "path": "/categorias"
      },
      "response": {
        "body": [
          {
            "id": "0b1c2d3e-4f50-4617-8899-aabbccddeeff",
            "nome": "Esferas",
            "slug": "esferas"
          }
        ],
        "headers": {
          "Content-Type": "application/json"
        },
        "matchingRules": {
          "body": {
            "$": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type",
                  "min": 1
                }
              ]
            },
            "$[*].id": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}"
                }
              ]
            },
            "$[*].nome": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            },
            "$[*].slug": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "type"
                }
              ]
            }
          },
          "header": {
            "Content-Type": {
              "combine": "AND",
              "matchers": [
                {
                  "match": "regex",
                  "regex": "application\\/json.*"
                }
              ]
            }
          }
        },
        "status": 200
      }
    },
    {
      "description": "o detalhe de um produto que não existe",
      "providerStates": [
        {
          "name": "não existe produto com o slug nao-existe"
